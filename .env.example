# Chave da API da Anthropic, usada para gerar o diagnóstico estratégico completo.
# Sem essa variável, a ferramenta funciona em modo demonstração (relatório de exemplo).
ANTHROPIC_API_KEY=

# Senha usada pela equipe da agência para publicar/editar/remover conteúdo na Central de
# Aprovação (/aprovacao). Sem essa variável, a senha padrão "rioadmin" é usada — troque em produção.
APROVACAO_ADMIN_PASSWORD=
