# Chave da API da Anthropic, usada para gerar o diagnóstico estratégico completo.
# Sem essa variável, a ferramenta funciona em modo demonstração (relatório de exemplo).
ANTHROPIC_API_KEY=

# Token da API da Apify, usado para buscar os dados reais do perfil do Instagram
# automaticamente (bio, seguidores, posts, legendas) sem precisar digitar nada.
# Sem essa variável, a ferramenta tenta métodos gratuitos de melhor esforço e,
# se o Instagram bloquear, pede os dados manualmente.
# Crie uma conta em https://apify.com, gere um token em Settings > Integrations > API tokens.
APIFY_API_TOKEN=
