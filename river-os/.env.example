# Projeto Supabase (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL pública do app (usada nos e-mails de confirmação)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Rotina agendada (/api/cron): automações + e-mail. Opcional. ──
# Segredo que o agendador envia como "Authorization: Bearer ...". Gere um valor longo e aleatório.
CRON_SECRET=
# Chave de serviço do Supabase (Settings > API). Usada SOMENTE pela rota /api/cron; nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Envio de e-mail via Resend (https://resend.com). Sem estes valores a rota só faz "ensaio".
RESEND_API_KEY=
EMAIL_FROM="RIVER OS <no-reply@seudominio.com>"
